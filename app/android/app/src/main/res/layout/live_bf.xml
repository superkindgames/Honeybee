<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/live_card" android:padding="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center">
  <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/goldie_awake_round"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:text="BREASTFEEDING ·" android:textSize="13sp" android:textColor="#E6FFFFFF" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
  <Chronometer android:id="@+id/c_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:textSize="17sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
</LinearLayout><FrameLayout android:layout_width="4dp" android:layout_height="4dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><LinearLayout android:id="@+id/side_L" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/side_off">
