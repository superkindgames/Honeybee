  <Chronometer android:id="@+id/sc_L" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
  <TextView android:id="@+id/st_L" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:visibility="gone" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
  <TextView android:id="@+id/sh_L" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="tap to switch" android:textSize="11sp" android:textColor="#BFFFFFFF" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"/>
</LinearLayout><FrameLayout android:layout_width="4dp" android:layout_height="4dp"/><LinearLayout android:id="@+id/side_R" android:layout_width="0dp" android:layout_weight="1" android:layout_height="76dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/side_off">
  <TextView android:id="@+id/sl_R" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RIGHT" android:textSize="13sp" android:textColor="#D9FFFFFF" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
