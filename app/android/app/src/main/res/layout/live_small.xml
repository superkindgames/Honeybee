<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/live_card" android:paddingLeft="8dp" android:paddingRight="8dp">
  <ImageView android:id="@+id/sm_img" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/goldie_awake_round"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="10dp">
    <TextView android:id="@+id/sm_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#E6FFFFFF" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
    <Chronometer android:id="@+id/sm_c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
  </LinearLayout>
  <TextView android:id="@+id/sm_btn" android:layout_width="wrap_content" android:layout_height="40dp" android:paddingLeft="16dp" android:paddingRight="16dp" android:gravity="center" android:background="@drawable/pill_white" android:textSize="16sp" android:visibility="gone" android:textColor="#FF1A2133" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1"/>
</LinearLayout>
